{
  "name": "Track",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "artist": {
      "type": "string"
    },
    "channel": {
      "type": "string",
      "enum": [
        "jazz",
        "rnb",
        "worldbeat"
      ]
    },
    "file_url": {
      "type": "string"
    },
    "duration": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "artist",
    "channel",
    "file_url"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}