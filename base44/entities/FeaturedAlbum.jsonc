{
  "name": "FeaturedAlbum",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "artist": {
      "type": "string"
    },
    "channel": {
      "type": "string",
      "enum": [
        "jazz",
        "rnb",
        "worldbeat"
      ]
    },
    "image_url": {
      "type": "string"
    },
    "year": {
      "type": "string"
    },
    "review": {
      "type": "string"
    },
    "rating": {
      "type": "number"
    }
  },
  "required": [
    "title",
    "artist",
    "channel",
    "review"
  ]
}